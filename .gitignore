.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.superpowers/
data/scans.db
data/uploads/

# Her real document photos are test fixtures but never leave the machine.
# They carry her name, address and ARC number even with the passport covered.
tests/golden/fixtures/*
!tests/golden/fixtures/.gitkeep
!tests/golden/fixtures/*.synthetic.png
# Expectations for her real photos transcribe facts from them — deadline, amount,
# phrases from an immigration letter. Deny by default, like fixtures/, so a
# differently-named file cannot be committed by accident.
tests/golden/expected/*
!tests/golden/expected/*.synthetic.json

# Machine-specific choices written by setup; never shared.
.ilgeojwo.env
